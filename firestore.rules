rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow read, write: if isAuthenticated();
    }

    // Workspace Members collection
    match /workspace_members/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Invitations collection
    match /invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    // Audit Logs collection (Immutable, Append-Only)
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Strict audit trail integrity
    }

    // Workflows collection (scoped to workspace)
    match /workflows/{workflowId} {
      allow read, write: if isAuthenticated();
    }

    // Executions collection
    match /executions/{executionId} {
      allow read, write: if isAuthenticated();
    }

    // Connections & Secrets Vault collection
    match /connections/{connectionId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // System Status & Health collection
    match /system_status/{statusId} {
      allow read: if true; // Public status page
      allow write: if isAuthenticated();
    }

    // Usage Metrics collection
    match /usage_metrics/{usageId} {
      allow read, write: if isAuthenticated();
    }

    // User Feedback collection
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
    }

    // API Keys Vault collection
    match /api_keys/{keyId} {
      allow read, write: if isAuthenticated();
    }

    // Webhook Subscriptions & Dead Letter Queue collection
    match /webhooks/{webhookId} {
      allow read, write: if isAuthenticated();
    }

    // Transactions & Billing collection
    match /transactions/{txId} {
      allow read, write: if isAuthenticated();
    }

    // Workspace Trials collection
    match /workspace_trials/{trialId} {
      allow read, write: if isAuthenticated();
    }

    // Referrals collection
    match /referrals/{referralId} {
      allow read, write: if isAuthenticated();
    }

    // Trial Extensions collection
    match /trial_extensions/{extensionId} {
      allow read, write: if isAuthenticated();
    }

    // Default fallback rule
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
